          },
          "playlist_id": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DeletePlaylistResponse": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
