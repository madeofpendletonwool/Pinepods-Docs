# Copy to `.env` and fill in. `.env` is git-ignored — never commit real secrets.

# --- Umami backend (docker-compose.umami.yml) ---
# Strong random values. Generate e.g. with: openssl rand -base64 32
UMAMI_DB_PASSWORD=change-me-to-a-strong-password
UMAMI_APP_SECRET=change-me-to-a-long-random-string

# --- Docs build-time analytics wiring (docusaurus.config.js) ---
# These activate the tracking script in the built site. Leave unset to build
# WITHOUT analytics (local dev / CI). Set them (as Docker build args or shell
# env) after the Umami website exists:
#   UMAMI_WEBSITE_ID — the website's UUID from the Umami dashboard
#   UMAMI_SRC        — the tracking script URL served by your Umami instance
# UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# UMAMI_SRC=https://analytics.pinepods.online/script.js
