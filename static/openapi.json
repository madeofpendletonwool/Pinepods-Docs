              "null"
            ],
            "format": "int32"
          },
          "max_duration": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "sort_order": {
            "type": "string"
          },
          "group_by_podcast": {
            "type": "boolean"
          },
          "max_episodes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "icon_name": {
            "type": "string"
          }
        }
